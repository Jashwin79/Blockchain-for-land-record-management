const express = require("express");
const router = express.Router();
const {
  registerLand,
  transferOwnership,
  getAllLandParcels,
  getLandDetails,
} = require("../services/blockchain");

// Get all land parcels
router.get("/", async (req, res) => {
  try {
    const parcels = getAllLandParcels();
    res.json(parcels);
  } catch (error) {
    console.error("Get land parcels error:", error);
    res.status(500).json({ error: "Failed to fetch land parcels" });
  }
});

// Register new land parcel
router.post("/register", async (req, res) => {
  try {
    const { location, area, ownerAddress } = req.body;

    if (!location || !area || !ownerAddress) {
      return res
        .status(400)
        .json({ error: "Location, area, and owner address are required" });
    }

    // Validate owner address format
    if (!ownerAddress.match(/^0x[a-fA-F0-9]{40}$/)) {
      return res.status(400).json({ error: "Invalid owner address format" });
    }

    const result = await registerLand(location, area, ownerAddress);
    res.json({
      message: "Land registered successfully",
      txHash: result.txHash,
      parcel: result.parcel,
    });
  } catch (error) {
    console.error("Land registration error:", error);
    res.status(500).json({ error: error.message || "Failed to register land" });
  }
});

// Transfer land ownership
router.post("/transfer", async (req, res) => {
  try {
    const { parcelId, newOwner } = req.body;

    if (parcelId === undefined || !newOwner) {
      return res
        .status(400)
        .json({ error: "Parcel ID and new owner are required" });
    }

    // Validate new owner address format
    if (!newOwner.match(/^0x[a-fA-F0-9]{40}$/)) {
      return res
        .status(400)
        .json({ error: "Invalid new owner address format" });
    }

    const result = await transferOwnership(parcelId, newOwner);
    res.json({
      message: "Ownership transferred successfully",
      txHash: result.txHash,
      parcel: result.parcel,
    });
  } catch (error) {
    console.error("Ownership transfer error:", error);
    res
      .status(500)
      .json({ error: error.message || "Failed to transfer ownership" });
  }
});

// Get specific land parcel details
router.get("/:id", async (req, res) => {
  try {
    const parcelId = req.params.id;
    const landDetails = await getLandDetails(parcelId);
    res.json(landDetails);
  } catch (error) {
    console.error("Get land details error:", error);
    res
      .status(500)
      .json({ error: error.message || "Failed to get land details" });
  }
});

module.exports = router;
